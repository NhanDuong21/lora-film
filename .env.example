# Docker Compose reads this file. The locally executed Spring Boot services do
# not load it automatically; their defaults live in application.example.properties.

# MySQL root credentials are used by the init script and health check.
MYSQL_ROOT_PASSWORD=root123

# Application account created and granted access to every service database.
MYSQL_USER=movieuser
MYSQL_PASSWORD=moviepassword

# Host ports exposed by Docker Compose.
MYSQL_PORT=3307
KAFKA_PORT=9092

KAFKA_BROKER_ID=1
