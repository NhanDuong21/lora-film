MYSQL_ROOT_PASSWORD=root123          # Root password used by the MySQL init script/healthcheck
MYSQL_USER=movieuser            # Tài khoản phụ (không phải root)
MYSQL_PASSWORD=moviepassword    # Mật khẩu tài khoản phụ
MYSQL_PORT=3307                 # Ánh xạ ra ngoài cổng 3307 để tránh đè cổng 3306 của Windows local
DB_MAX_POOL_SIZE=5               # Safe default when all services run together
DB_MIN_IDLE=1

KAFKA_BROKER_ID=1
KAFKA_PORT=9092
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Service discovery and shared infrastructure
EUREKA_CLIENT_SERVICEURL_DEFAULTZONE=http://localhost:8761/eureka/
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
# Shared exclusively by booking-service -> promotion-service internal calls.
# Keep this single value unchanged for both services.
PROMOTION_BOOKING_SERVICE_TOKEN=booking-service-local-token
PROMOTION_PAYMENT_SERVICE_TOKEN=payment-service-local-token
PROMOTION_OPERATIONS_SERVICE_TOKEN=operations-service-local-token
PAYMENT_TRUST_VERIFIED_BROWSER_RETURN=false

# Analytics Service
ANALYTICS_KAFKA_GROUP=analytics-service-v1
ANALYTICS_KAFKA_LISTENER_ENABLED=true
ANALYTICS_ZONE_ID=Asia/Ho_Chi_Minh
ANALYTICS_SCHEDULER_CRON="0 10 1 * * *"
ANALYTICS_LOOKBACK_DAYS=3

# Cloudinary credentials for user-service file storage
FILE_STORAGE_PROVIDER=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=lorafilm/user-service
CLOUDINARY_TIMEOUT_MS=10000

# Notification service runs locally as Java; Docker Compose supplies infrastructure only.
NOTIFICATION_TEMPLATE_GIT_URI=https://github.com/vinhth05/temple-mail.git
NOTIFICATION_TEMPLATE_GIT_WORKDIR=C:/lorafilm-data/template-registry
NOTIFICATION_TEMPLATE_GIT_USERNAME=
NOTIFICATION_TEMPLATE_GIT_TOKEN=
NOTIFICATION_TEMPLATE_AUTO_REFRESH_ENABLED=true
NOTIFICATION_TEMPLATE_REFRESH_INTERVAL_MS=30000
NOTIFICATION_TEMPLATE_REFRESH_INITIAL_DELAY_MS=5000
NOTIFICATION_RECIPIENT_ENCRYPTION_KEY=

# Shared internal token for Auth -> Notification, Notification -> User,
# Booking -> Movie, and generic internal Score APIs.
INTERNAL_NOTIFICATION_TOKEN=dev-internal-token

# All JWT producers/consumers must use the same Base64-encoded secret.
JWT_SECRET_KEY=

# Dedicated tokens for sensitive service pairs.
PAYMENT_TO_BOOKING_INTERNAL_TOKEN=payment-booking-local-token
SHOWTIME_TO_PAYMENT_INTERNAL_TOKEN=showtime-payment-local-token

# Direct local service-to-service URLs. Browser traffic still goes through Gateway.
FRONTEND_URL=http://localhost:5173
AUTH_SERVICE_URL=http://localhost:8081
MOVIE_SERVICE_URL=http://localhost:8082
BOOKING_SERVICE_BASE_URL=http://localhost:8083
PAYMENT_SERVICE_BASE_URL=http://localhost:8084
NOTIFICATION_SERVICE_URL=http://localhost:8085
USER_SERVICE_URL=http://localhost:8086

# External service wrappers used by Gateway and Movie Service
TMDB_SERVICE_URL=https://tmdb-api.nyanmovie.site
TMDB_BASE_URL=https://tmdb-api.nyanmovie.site
TMDB_API_KEY=local-dev-tmdb-api-key
LOCATION_API_BASE_URL=https://location-api.nyanmovie.site
LOCATION_API_KEY=local-dev-location-api-key

MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
