# Docker Compose đọc file này. Các Spring Boot service chạy ngoài Docker không tự
# đọc `.env`; giá trị mặc định tương ứng nằm trong application.example.properties.

# Tài khoản root MySQL dùng cho init script và health check.
MYSQL_ROOT_PASSWORD=root123

# Tài khoản ứng dụng được tạo và cấp quyền cho toàn bộ database của service.
MYSQL_USER=movieuser
MYSQL_PASSWORD=moviepassword

# Các port expose ra máy host.
MYSQL_PORT=3307
KAFKA_PORT=9092

KAFKA_BROKER_ID=1

